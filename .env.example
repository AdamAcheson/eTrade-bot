# Copy to .env and fill in for local use. NEVER commit the real .env file --
# it's already covered by .gitignore.
#
# CONSUMER_KEY / CONSUMER_SECRET: from your E*TRADE developer app registration.
# OAUTH_TOKEN / OAUTH_TOKEN_SECRET: obtained by running scripts/etrade_authorize.py
#   locally (it needs a browser -- this can't be done inside an AI chat session).
#   These expire at midnight US Eastern or after 2 hours of inactivity; re-run the
#   script when that happens.
# ACCOUNT_ID: your plain E*TRADE account ID (not the opaque accountIdKey) --
#   only needed if your sandbox login has more than one account.
#
# Set config/broker.yaml: mode: sandbox to actually use these (default is mode:
# paper, which needs none of this). See broker/etrade.py and
# scripts/etrade_sandbox_check.py before trusting the sandbox path for anything.

ETRADE_SANDBOX_CONSUMER_KEY=
ETRADE_SANDBOX_CONSUMER_SECRET=
ETRADE_SANDBOX_OAUTH_TOKEN=
ETRADE_SANDBOX_OAUTH_TOKEN_SECRET=
ETRADE_SANDBOX_ACCOUNT_ID=

# Production credentials would use their own separate ETRADE_PRODUCTION_* variables
# if/when a production adapter is ever implemented and explicitly authorized -- no
# such adapter exists in this codebase today, and setting these alone would not
# enable it. See config/broker.yaml and docs/ARCHITECTURE.md section 11.

# Twelve Data (twelvedata.com): free-tier historical 5-minute bars for backtesting
# only, going back years further than Yahoo's ~60-day cap -- see
# scripts/fetch_historical_data_twelvedata.py. Not used by the live trading path.
TWELVEDATA_API_KEY=
