# Copy to .env and fill in for local use. NEVER commit the real .env file.
# Nothing in this codebase currently reads these -- broker/etrade.py is an
# unimplemented stub -- but the variable NAMES are fixed here to match
# config/broker.yaml so the wiring is ready when that adapter is implemented.

ETRADE_SANDBOX_CONSUMER_KEY=
ETRADE_SANDBOX_CONSUMER_SECRET=
ETRADE_SANDBOX_OAUTH_TOKEN=
ETRADE_SANDBOX_OAUTH_TOKEN_SECRET=
ETRADE_SANDBOX_ACCOUNT_ID=

# Production credentials would use their own separate ETRADE_PRODUCTION_* variables
# once/if a production adapter is ever implemented and explicitly authorized. Setting
# these alone does not enable live trading -- see config/broker.yaml and
# docs/ARCHITECTURE.md section 11.
ETRADE_ENV=sandbox
